# Copy this file to .env.local and fill in the values from your Supabase
# project: Dashboard -> Project Settings -> API.
#
# Both values are safe to expose in the browser bundle. Row Level Security is
# what protects the data. NEVER put the service_role key in a VITE_ variable --
# anything prefixed VITE_ is compiled into the public JS bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
